{
  "name": "dirviz",
  "version": "0.1.0",
  "description": "Visualize any codebase — dependency graphs, AI summaries, error tracing, and feature guidance in a local interactive UI",
  "main": "dist/cli.js",
  "bin": {
    "dirviz": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-ui.js",
    "dev": "ts-node src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "codebase",
    "visualization",
    "dependency-graph",
    "devtools",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@google/generative-ai": "^0.15.0",
    "d3": "^7.9.0",
    "ollama": "^0.5.0",
    "open": "^10.1.0",
    "openai": "^4.52.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^20.14.0",
    "@types/yargs": "^17.0.32",
    "esbuild": "^0.21.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/"
  ]
}
